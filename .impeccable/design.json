      "html": "<button class=\"ds-btn-primary\">Send</button>",
      "css": ".ds-btn-primary { display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:0;border-radius:8px;background:var(--primary,#1a1c1f);color:var(--primary-foreground,#fff);font:500 14px -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif;cursor:pointer;transition:background-color 150ms; }.ds-btn-primary:hover{background:color-mix(in srgb,var(--primary,#1a1c1f) 88%,transparent)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring,#0670d3);outline-offset:2px}"
