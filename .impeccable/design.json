      "html": "<button class=\"ds-btn-outline\">Review changes</button>",
      "css": ".ds-btn-outline { display:inline-flex;align-items:center;justify-content:center;height:36px;padding:8px 12px;border:1px solid var(--border-strong,#d7d7d7);border-radius:8px;background:var(--card,#f7f7f7);color:var(--text,#1a1c1f);font:500 14px -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif;cursor:pointer;transition:background-color 150ms,border-color 150ms; }.ds-btn-outline:hover{background:var(--bg-hover,#ededed);border-color:var(--border-strong,#d7d7d7)}.ds-btn-outline:focus-visible{outline:2px solid var(--ring,#0670d3);outline-offset:2px}"
