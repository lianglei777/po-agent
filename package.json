{
  "name": "po-agent",
  "version": "0.2.2",
  "description": "Local desktop workspace for the Pi coding agent.",
  "author": "Leon Wei",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev -p 51731",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && node --test desktop/desktop-runtime.test.mjs desktop/prepare-standalone.test.mjs scripts/docker-release.test.mjs scripts/login-test.test.mjs",
    "test:qianwen-smoke": "vitest run src/server/infrastructure/content-generation/qianwen/qianwen-paid-smoke.integration.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "login:test": "npm run build && node scripts/login-test.mjs",
    "login:test:reset": "node scripts/reset-login-test.mjs",
    "docker:release": "node scripts/docker-release.mjs",
    "docker:push": "node scripts/docker-push.mjs",
    "desktop:prepare": "node desktop/prepare-standalone.mjs",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron .",
    "desktop:pack": "npm run build && npm run desktop:prepare && electron-builder --dir --publish never",
    "desktop:pack:cn": "npm run build && npm run desktop:prepare && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --dir --publish never",
    "desktop:dist": "npm run build && npm run desktop:prepare && electron-builder --publish never",
    "desktop:dist:cn": "npm run build && npm run desktop:prepare && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --publish never"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xyflow/react": "^12.11.3",
    "antd": "^6.5.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "motion": "^12.42.2",
    "next": "16.2.1",
    "pi-web-access": "0.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "typebox": "^1.3.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "postcss": "^8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.poagent.app",
    "productName": "Po Agent",
    "icon": "build/icon.png",
    "directories": {
      "output": ".desktop-dist"
    },
    "files": [
      "desktop/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules/**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static"
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
